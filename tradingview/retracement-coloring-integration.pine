//@version=5
indicator("Impulse – Retracement Quality System with Advanced Risk Management + Candle Coloring", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================
// INPUT SETTINGS
// ============================================

grpBalance = "Balance Detection"
balancePeriod = input.int(20, "Balance Period (candles)", minval=5, maxval=50, group=grpBalance, tooltip="Period to detect price balance/range")
balanceTolerance = input.float(0.02, "Balance Tolerance (%)", minval=0.01, maxval=0.1, step=0.01, group=grpBalance, tooltip="Price range tolerance to consider as balance")

grpImpulse = "Impulse Detection"
impulseLookback = input.int(5, "Impulse Lookback Candles", minval=2, maxval=15, group=grpImpulse, tooltip="Candles to scan for impulse move")
impulseATRMult = input.float(2.0, "Impulse Min Size (ATR Multiple)", minval=1.0, maxval=5.0, step=0.1, group=grpImpulse, tooltip="Minimum impulse size in ATR multiples")
bodyRatioMin = input.float(0.60, "Min Body Ratio", minval=0.3, maxval=0.9, step=0.05, group=grpImpulse, tooltip="Minimum candle body size vs full range")
useVolConfirm = input.bool(true, "Require Volume Confirmation", group=grpImpulse)
volMultiplier = input.float(1.3, "Volume Multiplier", minval=0.8, maxval=3.0, step=0.1, group=grpImpulse)
volAvgPeriod = input.int(20, "Volume Average Period", minval=5, maxval=50, group=grpImpulse)

grpFib = "Fibonacci Levels"
showFibLines = input.bool(true, "Show Fibonacci Lines", group=grpFib)

grpSets = "Set 1 & Set 2 Configuration"
set1StartFib = input.float(0.50, "Set 1 Zone Start (%)", minval=0.4, maxval=0.6, step=0.05, group=grpSets)
set1EndFib = input.float(0.618, "Set 1 Zone End (%)", minval=0.6, maxval=0.7, step=0.05, group=grpSets)
set2StartFib = input.float(0.618, "Set 2 Zone Start (%)", minval=0.6, maxval=0.8, step=0.05, group=grpSets)
set2EndFib = input.float(0.85, "Set 2 Zone End (%)", minval=0.8, maxval=0.95, step=0.05, group=grpSets)

grpQuality = "Quality Assessment"
assessQuality = input.bool(true, "Assess Signal Quality", group=grpQuality)
minQualityLevel = input.string("Low", "Minimum Quality Level", options=["Low", "Medium", "High"], group=grpQuality)

grpRetracement = "Retracement Quality Analysis"
enableRetracementAnalysis = input.bool(true, "Enable Retracement Analysis", group=grpRetracement)
retracementVolThreshold = input.float(0.8, "Low Volume Threshold (x Avg)", minval=0.3, maxval=1.5, step=0.1, group=grpRetracement)
choppyBodyRatio = input.float(0.4, "Choppy Candle Body Ratio", minval=0.1, maxval=0.7, step=0.05, group=grpRetracement)
minRetracementBars = input.int(3, "Min Retracement Bars", minval=2, maxval=10, group=grpRetracement)
showRetracementScore = input.bool(true, "Show Retracement Quality Score", group=grpRetracement)
strongRetColor = input.color(color.orange, "Strong Retracement Color", group=grpRetracement)
weakRetColor = input.color(color.white, "Weak Retracement Color", group=grpRetracement)
showRetracementLeg = input.bool(true, "Show Retracement Leg Lines", group=grpRetracement)
retLegStrongColor = input.color(color.lime, "Strong Leg Color", group=grpRetracement)
retLegWeakColor = input.color(color.red, "Weak Leg Color", group=grpRetracement)

grpRetAdvanced = "Advanced Retracement Metrics"
enableAdvancedMetrics = input.bool(true, "Enable Advanced Metrics", group=grpRetAdvanced)
overlapWeight = input.float(0.20, "Overlap Score Weight", minval=0.0, maxval=0.5, step=0.05, group=grpRetAdvanced)
volWeight = input.float(0.30, "Volume Score Weight", minval=0.0, maxval=0.5, step=0.05, group=grpRetAdvanced)
choppyWeight = input.float(0.25, "Choppy Score Weight", minval=0.0, maxval=0.5, step=0.05, group=grpRetAdvanced)
momentumWeight = input.float(0.15, "Momentum Score Weight", minval=0.0, maxval=0.5, step=0.05, group=grpRetAdvanced)
atrWeight = input.float(0.10, "ATR Contraction Weight", minval=0.0, maxval=0.5, step=0.05, group=grpRetAdvanced)
strongScoreThreshold = input.float(60.0, "Strong Signal Threshold", minval=30.0, maxval=90.0, step=5.0, group=grpRetAdvanced)

grpCandleColor = "Retracement Candle Coloring"
enableCandleColoring = input.bool(true, "Enable Retracement Candle Coloring", group=grpCandleColor)
candleColorMode = input.string("Per Candle", "Coloring Mode", options=["Per Candle", "Whole Leg"], group=grpCandleColor, tooltip="Per Candle: each candle colored by its own quality. Whole Leg: all candles colored by majority quality.")
strongCandleColor = input.color(color.new(color.orange, 0), "Strong Quality Color", group=grpCandleColor)
moderateCandleColor = input.color(color.new(color.yellow, 0), "Moderate Quality Color", group=grpCandleColor)
weakCandleColor = input.color(color.new(color.white, 0), "Weak Quality Color", group=grpCandleColor)
moderateScoreThreshold = input.float(40.0, "Moderate Score Threshold", minval=20.0, maxval=60.0, step=5.0, group=grpCandleColor)

grpRisk = "Risk Management"
showExitLevels = input.bool(true, "Show Exit Levels", group=grpRisk)
exitLineColor = input.color(color.red, "Exit Line Color", group=grpRisk)
exitLabelSize = input.string("small", "Exit Label Size", options=["tiny", "small", "normal"], group=grpRisk)

grpVisual = "Visual Settings"
impulseBoxColor = input.color(color.new(color.purple, 75), "Impulse Box Color", group=grpVisual)
set1ZoneColor = input.color(color.new(color.blue, 75), "Set 1 Zone Color", group=grpVisual)
set2ZoneColor = input.color(color.new(color.orange, 75), "Set 2 Zone Color", group=grpVisual)
bullColor = input.color(color.green, "Bullish Signal Color", group=grpVisual)
bearColor = input.color(color.red, "Bearish Signal Color", group=grpVisual)
showImpulseBox = input.bool(true, "Show Impulse Box", group=grpVisual)
showSetZones = input.bool(true, "Show Set 1 & Set 2 Zones", group=grpVisual)
showSignals = input.bool(true, "Show Buy/Sell Signals", group=grpVisual)

grpAlert = "Alerts"
alertOnImpulse = input.bool(true, "Alert on Impulse", group=grpAlert)
alertOnSet1 = input.bool(true, "Alert on Set 1", group=grpAlert)
alertOnSet2 = input.bool(true, "Alert on Set 2", group=grpAlert)
alertOnInvalidation = input.bool(true, "Alert on Invalidation", group=grpAlert)
alertOnExitHit = input.bool(true, "Alert on Exit Level Hit", group=grpAlert)

// ============================================
// CORE CALCULATIONS
// ============================================

atr14 = ta.atr(14)
volAvg = ta.sma(volume, volAvgPeriod)

// ============================================
// BALANCE DETECTION
// ============================================

balanceHigh = ta.highest(high, balancePeriod)
balanceLow = ta.lowest(low, balancePeriod)
balanceRange = balanceHigh - balanceLow
balanceMid = (balanceHigh + balanceLow) / 2
isInBalance = balanceRange < (balanceMid * balanceTolerance)

// ============================================
// IMPULSE DETECTION
// ============================================

impulseHigh = ta.highest(high, impulseLookback)
impulseLow = ta.lowest(low, impulseLookback)
impulseSize = impulseHigh - impulseLow

bullishScore = (close - impulseLow) / math.max(impulseSize, syminfo.mintick)
bearishScore = (impulseHigh - close) / math.max(impulseSize, syminfo.mintick)

var int bullCount = 0
var int bearCount = 0
bullCount := 0
bearCount := 0

for i = 0 to impulseLookback - 1
    bSize = math.abs(close[i] - open[i])
    cRange = high[i] - low[i]
    bRatio = cRange > 0 ? bSize / cRange : 0
    if close[i] > open[i] and bRatio >= bodyRatioMin
        bullCount += 1
    if close[i] < open[i] and bRatio >= bodyRatioMin
        bearCount += 1

majorityBull = bullCount >= math.ceil(impulseLookback * 0.6)
majorityBear = bearCount >= math.ceil(impulseLookback * 0.6)

volConfirmed = not useVolConfirm or volume > volAvg * volMultiplier

strongBullImpulse = impulseSize >= atr14 * impulseATRMult and majorityBull and bullishScore > 0.65 and volConfirmed and close > open
strongBearImpulse = impulseSize >= atr14 * impulseATRMult and majorityBear and bearishScore > 0.65 and volConfirmed and close < open

var bool prevBullImpulse = false
var bool prevBearImpulse = false
newBullImpulse = strongBullImpulse and not prevBullImpulse
newBearImpulse = strongBearImpulse and not prevBearImpulse
prevBullImpulse := strongBullImpulse
prevBearImpulse := strongBearImpulse

// ============================================
// STATE MANAGEMENT
// ============================================

var int direction = 0
var float impulseStartPrice = na
var float impulseEndPrice = na
var int impulseStartBar = na
var int impulseEndBar = na
var bool impulseComplete = false
var bool set1Fired = false
var bool set2Fired = false
var float set1Top = na
var float set1Bottom = na
var float set2Top = na
var float set2Bottom = na
var string signalQuality = "Low"

var bool inTrade = false
var float stopLossLevel = na
var float takeProfitLevel = na
var int tradeDirection = 0
var bool exitHit = false

var int retracementStartBar = na
var float retracementStartPrice = na
var bool inRetracement = false
var int retracementType = 0
var float set1RetracementQuality = 50.0
var float set2RetracementQuality = 50.0
var string set1QualityText = "Medium"
var string set2QualityText = "Medium"
var bool set1IsStrong = false
var bool set2IsStrong = false

var float set1VolScore = 0.0
var float set1ChoppyScore = 0.0
var float set1OverlapScore = 0.0
var float set1MomentumScore = 0.0
var float set1AtrScore = 0.0
var float set2VolScore = 0.0
var float set2ChoppyScore = 0.0
var float set2OverlapScore = 0.0
var float set2MomentumScore = 0.0
var float set2AtrScore = 0.0

var int wholeLegStrongCount = 0
var int wholeLegModerateCount = 0
var int wholeLegWeakCount = 0
var int wholeLegTotalBars = 0
var string wholeLegQuality = "Weak"
var color wholeLegColor = color.white

if newBullImpulse
    direction := 1
    impulseStartPrice := impulseLow
    impulseEndPrice := impulseHigh
    impulseStartBar := bar_index - impulseLookback + 1
    impulseEndBar := bar_index
    impulseComplete := false
    set1Fired := false
    set2Fired := false
    inTrade := false
    exitHit := false
    inRetracement := false
    retracementType := 0
    wholeLegStrongCount := 0
    wholeLegModerateCount := 0
    wholeLegWeakCount := 0
    wholeLegTotalBars := 0

if newBearImpulse
    direction := -1
    impulseStartPrice := impulseHigh
    impulseEndPrice := impulseLow
    impulseStartBar := bar_index - impulseLookback + 1
    impulseEndBar := bar_index
    impulseComplete := false
    set1Fired := false
    set2Fired := false
    inTrade := false
    exitHit := false
    inRetracement := false
    retracementType := 0
    wholeLegStrongCount := 0
    wholeLegModerateCount := 0
    wholeLegWeakCount := 0
    wholeLegTotalBars := 0

if direction == 1 and not impulseComplete
    if high > impulseEndPrice
        impulseEndPrice := high
        impulseEndBar := bar_index
    if close < close[1] and close < close[2]
        impulseComplete := true

if direction == -1 and not impulseComplete
    if low < impulseEndPrice
        impulseEndPrice := low
        impulseEndBar := bar_index
    if close > close[1] and close > close[2]
        impulseComplete := true

// ============================================
// FIBONACCI ZONE CALCULATION
// ============================================

fibMoveSize = math.abs(impulseEndPrice - impulseStartPrice)

if direction == 1 and impulseComplete
    set1Top := impulseEndPrice - (fibMoveSize * set1StartFib)
    set1Bottom := impulseEndPrice - (fibMoveSize * set1EndFib)
    set2Top := impulseEndPrice - (fibMoveSize * set2StartFib)
    set2Bottom := impulseEndPrice - (fibMoveSize * set2EndFib)

if direction == -1 and impulseComplete
    set1Bottom := impulseEndPrice + (fibMoveSize * set1StartFib)
    set1Top := impulseEndPrice + (fibMoveSize * set1EndFib)
    set2Bottom := impulseEndPrice + (fibMoveSize * set2StartFib)
    set2Top := impulseEndPrice + (fibMoveSize * set2EndFib)

// ============================================
// PER-CANDLE QUALITY SCORE
// ============================================

getCandleQualityScore() =>
    isLowVol = volume < nz(volAvg, volume) * retracementVolThreshold
    bdy = math.abs(close - open)
    rng = high - low
    br = rng > 0 ? bdy / rng : 0
    isChoppy = br < choppyBodyRatio
    hasOverlap = false
    if bar_index > 0
        prevH = high[1]
        prevL = low[1]
        overlapAmt = math.min(high, prevH) - math.max(low, prevL)
        hasOverlap := overlapAmt > 0
    barATR = rng
    impulseATRVal = nz(atr14, 1.0)
    atrContract = impulseATRVal > 0 ? 1 - (barATR / impulseATRVal) : 0
    atrContract := math.max(0, math.min(1, atrContract))
    volPts = isLowVol ? 100.0 : 0.0
    choppyPts = isChoppy ? 100.0 : 0.0
    overlapPts = hasOverlap ? 100.0 : 0.0
    atrPts = atrContract * 100
    momentumPts = (1 - br) * 100
    totalW = volWeight + choppyWeight + overlapWeight + momentumWeight + atrWeight
    rawScore = volPts * volWeight + choppyPts * choppyWeight + overlapPts * overlapWeight + momentumPts * momentumWeight + atrPts * atrWeight
    finalScore = totalW > 0 ? rawScore / totalW : 50.0
    finalScore := math.max(0, math.min(100, finalScore))
    finalScore

candleScore = getCandleQualityScore()

// ============================================
// RETRACEMENT QUALITY - CALCULATED EVERY BAR
// ============================================

retStartBarCalc = na(retracementStartBar) ? 0 : retracementStartBar
retEndBarCalc = bar_index
retraceBarsCalc = retEndBarCalc - retStartBarCalc
retraceBarsCalc := math.max(retraceBarsCalc, 0)
retraceBarsCalc := math.min(retraceBarsCalc, 499)

var float calcQS = 50.0
var float calcVS = 50.0
var float calcCS = 50.0
var float calcOS = 50.0
var float calcMS = 50.0
var float calcAS = 50.0
var string calcQT = "Medium"
var bool calcIsStrong = false

if retraceBarsCalc >= minRetracementBars
    lowVolBars = 0
    totalBars = 0
    choppyBars = 0
    avgBodyRatio = 0.0
    consecutiveBars = 0
    maxConsecutive = 0
    lastDir = 0
    overlapBars = 0
    totalATR = 0.0
    impulseATRVal = nz(atr14, 1.0)

    for i = 0 to retraceBarsCalc - 1
        lookback = retraceBarsCalc - i - 1
        if lookback >= 0 and lookback < 500
            if volume[lookback] < nz(volAvg[lookback], volume[lookback]) * retracementVolThreshold
                lowVolBars += 1
            totalBars += 1
            bdy = math.abs(close[lookback] - open[lookback])
            rng = high[lookback] - low[lookback]
            br = rng > 0 ? bdy / rng : 0
            avgBodyRatio += br
            if br < choppyBodyRatio
                choppyBars += 1
            curDir = close[lookback] > open[lookback] ? 1 : -1
            if curDir == lastDir
                consecutiveBars += 1
                maxConsecutive := math.max(maxConsecutive, consecutiveBars)
            else
                consecutiveBars := 1
            lastDir := curDir
            if lookback > 0 and (lookback + 1) < 500
                prevHigh = high[lookback + 1]
                prevLow = low[lookback + 1]
                curHigh = high[lookback]
                curLow = low[lookback]
                overlapAmt = math.min(curHigh, prevHigh) - math.max(curLow, prevLow)
                if overlapAmt > 0
                    overlapBars += 1
            totalATR += rng

    if totalBars > 0
        avgBodyRatio := avgBodyRatio / totalBars
        avgBarATR = totalATR / totalBars
        atrContraction = impulseATRVal > 0 ? 1 - (avgBarATR / impulseATRVal) : 0
        atrContraction := math.max(0, math.min(1, atrContraction))
        calcVS := (lowVolBars / totalBars) * 100
        calcCS := (choppyBars / totalBars) * 100
        calcOS := totalBars > 1 ? (overlapBars / (totalBars - 1)) * 100 : 50.0
        calcMS := 100 - (maxConsecutive / totalBars * 100)
        calcAS := atrContraction * 100
        totalW = volWeight + choppyWeight + overlapWeight + momentumWeight + atrWeight
        rawScore = calcVS * volWeight + calcCS * choppyWeight + calcOS * overlapWeight + calcMS * momentumWeight + calcAS * atrWeight
        calcQS := totalW > 0 ? rawScore / totalW : 50.0
        calcQS := math.max(0, math.min(100, calcQS))
        calcQT := calcQS >= strongScoreThreshold ? "Strong" : calcQS >= moderateScoreThreshold ? "Moderate" : "Weak"
        calcIsStrong := calcQS >= strongScoreThreshold
    else
        calcQS := 50.0
        calcVS := 50.0
        calcCS := 50.0
        calcOS := 50.0
        calcMS := 50.0
        calcAS := 50.0
        calcQT := "Medium"
        calcIsStrong := false
else
    calcQS := 50.0
    calcVS := 50.0
    calcCS := 50.0
    calcOS := 50.0
    calcMS := 50.0
    calcAS := 50.0
    calcQT := "Medium"
    calcIsStrong := false

// ============================================
// RETRACEMENT TRACKING
// ============================================

if impulseComplete and direction != 0 and not inRetracement
    inRetracement := true
    retracementStartBar := impulseEndBar
    retracementStartPrice := impulseEndPrice
    retracementType := 1

// ============================================
// WHOLE LEG QUALITY TRACKING
// ============================================

isInRetracementZone = impulseComplete and direction != 0 and inRetracement

if isInRetracementZone and enableCandleColoring
    wholeLegTotalBars += 1
    if candleScore >= strongScoreThreshold
        wholeLegStrongCount += 1
    else if candleScore >= moderateScoreThreshold
        wholeLegModerateCount += 1
    else
        wholeLegWeakCount += 1
    if wholeLegStrongCount >= wholeLegModerateCount and wholeLegStrongCount >= wholeLegWeakCount
        wholeLegQuality := "Strong"
        wholeLegColor := strongCandleColor
    else if wholeLegModerateCount >= wholeLegStrongCount and wholeLegModerateCount >= wholeLegWeakCount
        wholeLegQuality := "Moderate"
        wholeLegColor := moderateCandleColor
    else
        wholeLegQuality := "Weak"
        wholeLegColor := weakCandleColor

// ============================================
// CANDLE COLORING
// ============================================

perCandleColor = candleScore >= strongScoreThreshold ? strongCandleColor : candleScore >= moderateScoreThreshold ? moderateCandleColor : weakCandleColor
applyCandleColor = enableCandleColoring and isInRetracementZone
finalCandleColor = applyCandleColor ? (candleColorMode == "Per Candle" ? perCandleColor : wholeLegColor) : na

barcolor(finalCandleColor, title="Retracement Candle Color")

// ============================================
// QUALITY ASSESSMENT
// ============================================

qualityScore = (impulseSize / atr14) * (bullCount + bearCount) / impulseLookback
signalQuality := qualityScore > 3.0 ? "High" : qualityScore > 1.5 ? "Medium" : "Low"
qualityColor = signalQuality == "High" ? color.green : signalQuality == "Medium" ? color.yellow : color.red
qualityPassed = (minQualityLevel == "Low") or (minQualityLevel == "Medium" and (signalQuality == "Medium" or signalQuality == "High")) or (minQualityLevel == "High" and signalQuality == "High")

// ============================================
// SIGNAL DETECTION
// ============================================

set1BuySignal = false
set1SellSignal = false
set2BuySignal = false
set2SellSignal = false

var bool stopLossHit = false
var bool takeProfitHit = false
var bool invalidationHit = false

if inTrade and not exitHit
    if tradeDirection == 1
        if low <= stopLossLevel
            stopLossHit := true
            exitHit := true
            inTrade := false
        else if high >= takeProfitLevel
            takeProfitHit := true
            exitHit := true
            inTrade := false
    else if tradeDirection == -1
        if high >= stopLossLevel
            stopLossHit := true
            exitHit := true
            inTrade := false
        else if low <= takeProfitLevel
            takeProfitHit := true
            exitHit := true
            inTrade := false

// Invalidation logic
if direction == 1 and impulseComplete and not na(impulseStartPrice)
    if low <= impulseStartPrice
        if inTrade
            exitHit := true
            invalidationHit := true
        direction := 0
        impulseComplete := false
        inTrade := false
        inRetracement := false

if direction == -1 and impulseComplete and not na(impulseStartPrice)
    if high >= impulseStartPrice
        if inTrade
            exitHit := true
            invalidationHit := true
        direction := 0
        impulseComplete := false
        inTrade := false
        inRetracement := false

// Target hit logic
if direction == 1 and impulseComplete and set2Fired
    if low <= impulseEndPrice
        if inTrade
            exitHit := true
            takeProfitHit := true
        direction := 0
        impulseComplete := false
        inTrade := false
        inRetracement := false

if direction == -1 and impulseComplete and set2Fired
    if high >= impulseEndPrice
        if inTrade
            exitHit := true
            takeProfitHit := true
        direction := 0
        impulseComplete := false
        inTrade := false
        inRetracement := false

// Set 1 Buy
if direction == 1 and impulseComplete and not na(set1Top) and qualityPassed
    if low <= set1Top and low >= set1Bottom and not set1Fired
        if enableRetracementAnalysis and inRetracement and retracementType == 1
            set1RetracementQuality := calcQS
            set1QualityText := calcQT
            set1IsStrong := calcIsStrong
            set1VolScore := calcVS
            set1ChoppyScore := calcCS
            set1OverlapScore := calcOS
            set1MomentumScore := calcMS
            set1AtrScore := calcAS
        set1BuySignal := true
        set1Fired := true
        inTrade := true
        tradeDirection := 1
        stopLossLevel := impulseStartPrice
        takeProfitLevel := impulseEndPrice
        stopLossHit := false
        takeProfitHit := false
        retracementStartBar := bar_index
        retracementStartPrice := low
        retracementType := 2
        wholeLegStrongCount := 0
        wholeLegModerateCount := 0
        wholeLegWeakCount := 0
        wholeLegTotalBars := 0

// Set 1 Sell
if direction == -1 and impulseComplete and not na(set1Top) and qualityPassed
    if high >= set1Bottom and high <= set1Top and not set1Fired
        if enableRetracementAnalysis and inRetracement and retracementType == 1
            set1RetracementQuality := calcQS
            set1QualityText := calcQT
            set1IsStrong := calcIsStrong
            set1VolScore := calcVS
            set1ChoppyScore := calcCS
            set1OverlapScore := calcOS
            set1MomentumScore := calcMS
            set1AtrScore := calcAS
        set1SellSignal := true
        set1Fired := true
        inTrade := true
        tradeDirection := -1
        stopLossLevel := impulseStartPrice
        takeProfitLevel := impulseEndPrice
        stopLossHit := false
        takeProfitHit := false
        retracementStartBar := bar_index
        retracementStartPrice := high
        retracementType := 2
        wholeLegStrongCount := 0
        wholeLegModerateCount := 0
        wholeLegWeakCount := 0
        wholeLegTotalBars := 0

// Set 2 Buy
if direction == 1 and impulseComplete and not na(set2Top) and qualityPassed
    if low <= set2Top and low >= set2Bottom and not set2Fired
        if enableRetracementAnalysis and inRetracement and retracementType == 2
            set2RetracementQuality := calcQS
            set2QualityText := calcQT
            set2IsStrong := calcIsStrong
            set2VolScore := calcVS
            set2ChoppyScore := calcCS
            set2OverlapScore := calcOS
            set2MomentumScore := calcMS
            set2AtrScore := calcAS
        set2BuySignal := true
        set2Fired := true
        inTrade := true
        tradeDirection := 1
        stopLossLevel := impulseStartPrice
        takeProfitLevel := impulseEndPrice
        stopLossHit := false
        takeProfitHit := false

// Set 2 Sell
if direction == -1 and impulseComplete and not na(set2Top) and qualityPassed
    if high >= set2Bottom and high <= set2Top and not set2Fired
        if enableRetracementAnalysis and inRetracement and retracementType == 2
            set2RetracementQuality := calcQS
            set2QualityText := calcQT
            set2IsStrong := calcIsStrong
            set2VolScore := calcVS
            set2ChoppyScore := calcCS
            set2OverlapScore := calcOS
            set2MomentumScore := calcMS
            set2AtrScore := calcAS
        set2SellSignal := true
        set2Fired := true
        inTrade := true
        tradeDirection := -1
        stopLossLevel := impulseStartPrice
        takeProfitLevel := impulseEndPrice
        stopLossHit := false
        takeProfitHit := false

// ============================================
// VISUAL: IMPULSE BOX
// ============================================

var box impulseBox = na

if showImpulseBox and direction != 0 and not na(impulseStartBar) and not na(impulseEndBar)
    if not na(impulseBox)
        box.delete(impulseBox)
    boxTop = direction == 1 ? impulseEndPrice : impulseStartPrice
    boxBot = direction == 1 ? impulseStartPrice : impulseEndPrice
    impulseBox := box.new(impulseStartBar, boxTop, impulseEndBar, boxBot, border_color=color.new(color.purple, 30), bgcolor=impulseBoxColor, border_width=2, text="IMPULSE", text_color=color.white, text_size=size.tiny)

// ============================================
// VISUAL: SET 1 & SET 2 ZONE BOXES
// ============================================

var box set1Box = na
var box set2Box = na

if showSetZones and impulseComplete and direction != 0 and not na(set1Top)
    if not na(set1Box)
        box.delete(set1Box)
    if not na(set2Box)
        box.delete(set2Box)
    zoneLeft = impulseEndBar
    zoneRight = bar_index + 30
    set1Box := box.new(zoneLeft, set1Top, zoneRight, set1Bottom, border_color=color.blue, bgcolor=set1ZoneColor, border_width=1, text="SET 1", text_color=color.blue, text_size=size.tiny, text_halign=text.align_left)
    set2Box := box.new(zoneLeft, set2Top, zoneRight, set2Bottom, border_color=color.orange, bgcolor=set2ZoneColor, border_width=1, text="SET 2", text_color=color.orange, text_size=size.tiny, text_halign=text.align_left)

// ============================================
// VISUAL: RETRACEMENT LEG LINES
// ============================================

if showRetracementLeg and enableRetracementAnalysis
    if set1BuySignal
        legCol = set1IsStrong ? retLegStrongColor : retLegWeakColor
        line.new(retracementStartBar, retracementStartPrice, bar_index, low, color=legCol, width=3, style=line.style_solid)
    if set1SellSignal
        legCol = set1IsStrong ? retLegStrongColor : retLegWeakColor
        line.new(retracementStartBar, retracementStartPrice, bar_index, high, color=legCol, width=3, style=line.style_solid)
    if set2BuySignal
        legCol = set2IsStrong ? retLegStrongColor : retLegWeakColor
        line.new(retracementStartBar, retracementStartPrice, bar_index, low, color=legCol, width=3, style=line.style_solid)
    if set2SellSignal
        legCol = set2IsStrong ? retLegStrongColor : retLegWeakColor
        line.new(retracementStartBar, retracementStartPrice, bar_index, high, color=legCol, width=3, style=line.style_solid)

// ============================================
// VISUAL EXIT LEVELS
// ============================================

var line stopLossLine = na
var line takeProfitLine = na
var label stopLossLabel = na
var label takeProfitLabel = na

exitLabelSizeVal = exitLabelSize == "tiny" ? size.tiny : exitLabelSize == "small" ? size.small : size.normal

if showExitLevels and inTrade and not na(stopLossLevel) and not na(takeProfitLevel)
    if not na(stopLossLine)
        line.delete(stopLossLine)
    if not na(takeProfitLine)
        line.delete(takeProfitLine)
    if not na(stopLossLabel)
        label.delete(stopLossLabel)
    if not na(takeProfitLabel)
        label.delete(takeProfitLabel)
    exitLeft = bar_index
    exitRight = bar_index + 20
    slTxt = "SL: " + str.tostring(stopLossLevel, format.mintick)
    tpTxt = "TP: " + str.tostring(takeProfitLevel, format.mintick)
    stopLossLine := line.new(exitLeft, stopLossLevel, exitRight, stopLossLevel, color=color.new(exitLineColor, 0), style=line.style_solid, width=2)
    takeProfitLine := line.new(exitLeft, takeProfitLevel, exitRight, takeProfitLevel, color=color.new(color.green, 0), style=line.style_solid, width=2)
    stopLossLabel := label.new(exitRight, stopLossLevel, slTxt, style=label.style_label_left, color=color.new(exitLineColor, 20), textcolor=color.white, size=exitLabelSizeVal)
    takeProfitLabel := label.new(exitRight, takeProfitLevel, tpTxt, style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=exitLabelSizeVal)

// ============================================
// VISUAL: FIBONACCI LINES
// ============================================

var line fib236Line = na
var line fib382Line = na
var line fib50Line = na
var line fib618Line = na
var line fib786Line = na

if showFibLines and impulseComplete and direction != 0 and not na(impulseStartPrice) and not na(impulseEndPrice)
    if not na(fib236Line)
        line.delete(fib236Line)
    if not na(fib382Line)
        line.delete(fib382Line)
    if not na(fib50Line)
        line.delete(fib50Line)
    if not na(fib618Line)
        line.delete(fib618Line)
    if not na(fib786Line)
        line.delete(fib786Line)
    fibLeft = impulseEndBar
    fibRight = bar_index + 30
    moveSize = math.abs(impulseEndPrice - impulseStartPrice)
    f236 = direction == 1 ? impulseEndPrice - (moveSize * 0.236) : impulseEndPrice + (moveSize * 0.236)
    f382 = direction == 1 ? impulseEndPrice - (moveSize * 0.382) : impulseEndPrice + (moveSize * 0.382)
    f50 = direction == 1 ? impulseEndPrice - (moveSize * 0.50) : impulseEndPrice + (moveSize * 0.50)
    f618 = direction == 1 ? impulseEndPrice - (moveSize * 0.618) : impulseEndPrice + (moveSize * 0.618)
    f786 = direction == 1 ? impulseEndPrice - (moveSize * 0.786) : impulseEndPrice + (moveSize * 0.786)
    fib236Line := line.new(fibLeft, f236, fibRight, f236, color=color.gray, style=line.style_dashed, width=1)
    fib382Line := line.new(fibLeft, f382, fibRight, f382, color=color.gray, style=line.style_dashed, width=1)
    fib50Line := line.new(fibLeft, f50, fibRight, f50, color=color.blue, style=line.style_solid, width=2)
    fib618Line := line.new(fibLeft, f618, fibRight, f618, color=color.orange, style=line.style_solid, width=2)
    fib786Line := line.new(fibLeft, f786, fibRight, f786, color=color.gray, style=line.style_dashed, width=1)

// ============================================
// RETRACEMENT QUALITY LABELS ON SIGNALS
// ============================================

if showRetracementScore and enableRetracementAnalysis
    s1RC = set1IsStrong ? strongRetColor : weakRetColor
    s2RC = set2IsStrong ? strongRetColor : weakRetColor
    if set1BuySignal
        rt = "RET: " + set1QualityText + " (" + str.tostring(set1RetracementQuality, "#.0") + ")"
        if enableAdvancedMetrics
            rt := rt + "\nV:" + str.tostring(set1VolScore, "#") + " C:" + str.tostring(set1ChoppyScore, "#") + " O:" + str.tostring(set1OverlapScore, "#") + " M:" + str.tostring(set1MomentumScore, "#") + " A:" + str.tostring(set1AtrScore, "#")
        label.new(bar_index, low * 0.998, rt, style=label.style_label_up, color=color.new(s1RC, 20), textcolor=color.black, size=size.small)
    if set1SellSignal
        rt = "RET: " + set1QualityText + " (" + str.tostring(set1RetracementQuality, "#.0") + ")"
        if enableAdvancedMetrics
            rt := rt + "\nV:" + str.tostring(set1VolScore, "#") + " C:" + str.tostring(set1ChoppyScore, "#") + " O:" + str.tostring(set1OverlapScore, "#") + " M:" + str.tostring(set1MomentumScore, "#") + " A:" + str.tostring(set1AtrScore, "#")
        label.new(bar_index, high * 1.002, rt, style=label.style_label_down, color=color.new(s1RC, 20), textcolor=color.black, size=size.small)
    if set2BuySignal
        rt = "RET: " + set2QualityText + " (" + str.tostring(set2RetracementQuality, "#.0") + ")"
        if enableAdvancedMetrics
            rt := rt + "\nV:" + str.tostring(set2VolScore, "#") + " C:" + str.tostring(set2ChoppyScore, "#") + " O:" + str.tostring(set2OverlapScore, "#") + " M:" + str.tostring(set2MomentumScore, "#") + " A:" + str.tostring(set2AtrScore, "#")
        label.new(bar_index, low * 0.997, rt, style=label.style_label_up, color=color.new(s2RC, 20), textcolor=color.black, size=size.small)
    if set2SellSignal
        rt = "RET: " + set2QualityText + " (" + str.tostring(set2RetracementQuality, "#.0") + ")"
        if enableAdvancedMetrics
            rt := rt + "\nV:" + str.tostring(set2VolScore, "#") + " C:" + str.tostring(set2ChoppyScore, "#") + " O:" + str.tostring(set2OverlapScore, "#") + " M:" + str.tostring(set2MomentumScore, "#") + " A:" + str.tostring(set2AtrScore, "#")
        label.new(bar_index, high * 1.003, rt, style=label.style_label_down, color=color.new(s2RC, 20), textcolor=color.black, size=size.small)

// ============================================
// SIGNAL PLOTTING
// ============================================

plotshape(newBullImpulse and showSignals, title="Bullish Impulse", location=location.belowbar, color=color.new(color.lime, 0), style=shape.arrowup, size=size.large, text="IMP↑")
plotshape(newBearImpulse and showSignals, title="Bearish Impulse", location=location.abovebar, color=color.new(color.maroon, 0), style=shape.arrowdown, size=size.large, text="IMP↓")
plotshape(set1BuySignal and showSignals, title="Set 1 Buy", location=location.belowbar, color=bullColor, style=shape.triangleup, size=size.normal, text="S1B")
plotshape(set1SellSignal and showSignals, title="Set 1 Sell", location=location.abovebar, color=bearColor, style=shape.triangledown, size=size.normal, text="S1S")
plotshape(set2BuySignal and showSignals, title="Set 2 Buy", location=location.belowbar, color=color.lime, style=shape.triangleup, size=size.large, text="S2B")
plotshape(set2SellSignal and showSignals, title="Set 2 Sell", location=location.abovebar, color=color.maroon, style=shape.triangledown, size=size.large, text="S2S")
plotshape(takeProfitHit and showSignals, title="Take Profit Hit", location=location.belowbar, color=color.green, style=shape.diamond, size=size.normal, text="TP")
plotshape(invalidationHit and showSignals, title="Invalidation", location=location.abovebar, color=color.orange, style=shape.xcross, size=size.normal, text="INV")

// ============================================
// QUALITY LABELS
// ============================================

var label qualityLabel = na

if set1BuySignal or set1SellSignal or set2BuySignal or set2SellSignal
    if assessQuality
        if not na(qualityLabel)
            label.delete(qualityLabel)
        lPrice = set1BuySignal or set2BuySignal ? low : high
        lStyle = set1BuySignal or set2BuySignal ? label.style_label_up : label.style_label_down
        qualityLabel := label.new(bar_index, lPrice, signalQuality, style=lStyle, color=qualityColor, textcolor=color.white, size=size.small)

// ============================================
// BACKGROUND
// ============================================

bgcolor(direction == 1 and impulseComplete ? color.new(color.green, 95) : direction == -1 and impulseComplete ? color.new(color.red, 95) : na, title="Impulse BG")
bgcolor(inTrade ? color.new(color.yellow, 97) : na, title="Trade BG")

// ============================================
// INFORMATION TABLE
// ============================================

var table infoPanel = table.new(position.top_right, 2, 18, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "Impulse + Ret v3.0", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 0, "Active", text_color=color.yellow, text_size=size.small)
    dTxt = direction == 1 ? "BULL" : direction == -1 ? "BEAR" : "NONE"
    dCol = direction == 1 ? color.green : direction == -1 ? color.red : color.gray
    table.cell(infoPanel, 0, 1, "Direction:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 1, dTxt, text_color=dCol, text_size=size.small)
    table.cell(infoPanel, 0, 2, "Impulse Done:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 2, impulseComplete ? "YES" : "NO", text_color=impulseComplete ? color.green : color.red, text_size=size.small)
    table.cell(infoPanel, 0, 3, "Quality:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 3, signalQuality, text_color=qualityColor, text_size=size.small)
    table.cell(infoPanel, 0, 4, "Set1 Fired:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 4, set1Fired ? "YES" : "NO", text_color=set1Fired ? color.green : color.gray, text_size=size.small)
    table.cell(infoPanel, 0, 5, "Set2 Fired:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 5, set2Fired ? "YES" : "NO", text_color=set2Fired ? color.green : color.gray, text_size=size.small)
    table.cell(infoPanel, 0, 6, "In Trade:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 6, inTrade ? "YES" : "NO", text_color=inTrade ? color.yellow : color.gray, text_size=size.small)
    table.cell(infoPanel, 0, 7, "Color Mode:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 7, candleColorMode, text_color=color.aqua, text_size=size.small)
    table.cell(infoPanel, 0, 8, "--- Retracement ---", text_color=color.aqua, text_size=size.small)
    table.cell(infoPanel, 1, 8, "Scores", text_color=color.aqua, text_size=size.small)
    s1C = set1IsStrong ? color.lime : color.red
    table.cell(infoPanel, 0, 9, "S1 Ret:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 9, set1QualityText + " (" + str.tostring(set1RetracementQuality, "#.0") + ")", text_color=s1C, text_size=size.small)
    s2C = set2IsStrong ? color.lime : color.red
    table.cell(infoPanel, 0, 10, "S2 Ret:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 10, set2QualityText + " (" + str.tostring(set2RetracementQuality, "#.0") + ")", text_color=s2C, text_size=size.small)
    wlC = wholeLegQuality == "Strong" ? color.lime : wholeLegQuality == "Moderate" ? color.yellow : color.red
    wlT = wholeLegQuality + " S:" + str.tostring(wholeLegStrongCount) + " M:" + str.tostring(wholeLegModerateCount) + " W:" + str.tostring(wholeLegWeakCount)
    table.cell(infoPanel, 0, 11, "Whole Leg:", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 11, wlT, text_color=wlC, text_size=size.small)
    if enableAdvancedMetrics
        table.cell(infoPanel, 0, 12, "Vol:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 12, str.tostring(calcVS, "#.0"), text_color=calcVS > 60 ? color.lime : color.red, text_size=size.small)
        table.cell(infoPanel, 0, 13, "Choppy:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 13, str.tostring(calcCS, "#.0"), text_color=calcCS > 60 ? color.lime : color.red, text_size=size.small)
        table.cell(infoPanel, 0, 14, "Overlap:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 14, str.tostring(calcOS, "#.0"), text_color=calcOS > 60 ? color.lime : color.red, text_size=size.small)
        table.cell(infoPanel, 0, 15, "Momentum:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 15, str.tostring(calcMS, "#.0"), text_color=calcMS > 60 ? color.lime : color.red, text_size=size.small)
        table.cell(infoPanel, 0, 16, "ATR Contr:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 16, str.tostring(calcAS, "#.0"), text_color=calcAS > 60 ? color.lime : color.red, text_size=size.small)
        table.cell(infoPanel, 0, 17, "Composite:", text_color=color.white, text_size=size.small)
        table.cell(infoPanel, 1, 17, str.tostring(calcQS, "#.0") + " " + calcQT, text_color=calcIsStrong ? color.lime : color.red, text_size=size.small)

// ============================================
// ALERTS
// ============================================

alertcondition(newBullImpulse, title="Bullish Impulse", message="Bullish Impulse Detected")
alertcondition(newBearImpulse, title="Bearish Impulse", message="Bearish Impulse Detected")
alertcondition(set1BuySignal, title="Set 1 Buy", message="Set 1 Buy Signal")
alertcondition(set1SellSignal, title="Set 1 Sell", message="Set 1 Sell Signal")
alertcondition(set2BuySignal, title="Set 2 Buy", message="Set 2 Buy Signal")
alertcondition(set2SellSignal, title="Set 2 Sell", message="Set 2 Sell Signal")
alertcondition(stopLossHit, title="Stop Loss Hit", message="Stop Loss Level Hit")
alertcondition(takeProfitHit, title="Take Profit Hit", message="Take Profit Level Hit")
alertcondition(invalidationHit, title="Invalidation", message="Trade Invalidated")
